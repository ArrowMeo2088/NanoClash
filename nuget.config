<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- 本仓库专用包缓存，避免重复下载到全局目录 -->
    <add key="globalPackagesFolder" value="Packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
